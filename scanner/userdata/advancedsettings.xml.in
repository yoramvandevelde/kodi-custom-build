<advancedsettings>
  <!-- Identical to the streamer's database config (see the userdata templates
       in omega/patches/0002-*.patch) and it has to stay that way: this is what
       points the scanner at the same shared library rather than a private one.
       Resolved from the same env vars, by scanner/provision.sh instead of by
       CMake. -->
  <videodatabase>
    <type>mysql</type>
    <host>@KODI_DB_HOST@</host>
    <port>@KODI_DB_PORT@</port>
    <user>@KODI_DB_USER@</user>
    <pass>@KODI_DB_PASS@</pass>
  </videodatabase>
  <musicdatabase>
    <type>mysql</type>
    <host>@KODI_DB_HOST@</host>
    <port>@KODI_DB_PORT@</port>
    <user>@KODI_DB_USER@</user>
    <pass>@KODI_DB_PASS@</pass>
  </musicdatabase>

  <!-- No <videolibrary><cleanonupdate>, deliberately.
       The clean decides what to delete by checking whether each path still
       exists, and this source is WebDAV over the network. When that stalls,
       unreachable reads as gone: a run whose connection died mid-clean removed
       roughly 700 titles that were perfectly fine, and the tables it walks do
       not log, so it happened silently.
       They came back on the next scan (the NFOs sit beside the files), but the
       re-added rows are new idFile entries, so watched state and resume points
       for those titles are lost. Not worth it for the convenience of automatic
       tidying. Clean by hand, on a moment when the source is known healthy. -->

  <!-- Debug logging, on purpose and permanently. This box has no screen and no
       watchdog, so when a scan hangs kodi.log is the only thing that says which
       path it stopped on.

       It is affordable because ~/.kodi/temp is redirected to disk while the
       rest of the profile sits in RAM (see scan-wrapper.sh). A few hundred MB
       per full scan would not fit in the tmpfs; on disk it is unremarkable. -->
  <loglevel>1</loglevel>
</advancedsettings>
